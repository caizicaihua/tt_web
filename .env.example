# Public configuration only. Empty uses the same-origin /portal/v1 API.
VITE_API_BASE_URL=/portal/v1
VITE_ENABLE_MOCK=true
# Real OAuth destination hostnames, comma separated; set from backend configuration.
VITE_TIKTOK_AUTH_HOSTS=
# Optional development proxy to the Webman backend; leave empty until available.
DEV_API_TARGET=
